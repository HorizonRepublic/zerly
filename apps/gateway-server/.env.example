# ============================================================================
# zerly-gateway-server — environment configuration
# ============================================================================
#
# Copy to `.env` and adjust, OR export via docker-compose env_file /
# k8s ConfigMap / shell export. The gateway does NOT auto-load `.env`
# at startup — config is read directly from process environment.
#
# Only infrastructure settings live here. Per-endpoint configuration
# (HTTP routes, CORS, rate limiting, response headers, per-route
# timeout, auth) is controlled by @zerly/gateway-sdk on the Nest side
# and delivered to the gateway via the handler_registry NATS KV bucket.
#
# Legend: [REQUIRED] must be set or the gateway refuses to start.
#         All other values show the compiled-in defaults.
# ============================================================================

# ----------------------------------------------------------------------------
# HTTP listener
# ----------------------------------------------------------------------------

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_MAX_BODY_BYTES=1048576
HTTP_MAX_HEADER_BYTES=16384

# ----------------------------------------------------------------------------
# NATS transport
# ----------------------------------------------------------------------------

# [REQUIRED] Comma-separated NATS server URLs.
NATS_URLS=nats://localhost:4222

NATS_RANDOMIZE_URLS=true
NATS_DISCOVER_SERVERS=true
NATS_USER=
NATS_PASSWORD=
NATS_CREDS_FILE=
NATS_CONNECTION_POOL=1
NATS_RECONNECT_WAIT=2s
NATS_MAX_RECONNECTS=-1
NATS_RECONNECT_BUFSIZE=8388608

# ----------------------------------------------------------------------------
# Handler registry KV bucket
# ----------------------------------------------------------------------------

# Must match the bucket name used by @horizon-republic/nestjs-jetstream
# on the Nest side (default: handler_registry).
KV_BUCKET=handler_registry
KV_WATCH_TIMEOUT=5s

# ----------------------------------------------------------------------------
# Request lifecycle
# ----------------------------------------------------------------------------

# Global fallback timeout. Per-route timeouts configured via
# @GatewayRoute({ timeout }) override this value.
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=30s

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------

LOG_LEVEL=info
LOG_FORMAT=json
LOG_REQUESTS=true
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
LOG_SLOW_REQUEST_MS=1000
LOG_SAMPLING_RATE=1

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------

# "production" redacts error details from HTTP responses.
ENVIRONMENT=production
