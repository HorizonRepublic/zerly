# ============================================================================
# zerly-gateway-server — environment configuration template
# ============================================================================
#
# Copy this file to `.env` and adjust values for your deployment, OR export
# the same variables via your orchestrator (docker-compose `env_file`, k8s
# ConfigMap/Secret, systemd `Environment=`, shell `export`).
#
# NOTE: The gateway does NOT auto-load a `.env` file at startup — config is
# read directly from the process environment via caarlos0/env. This file is
# purely a reference of every knob available, with the production defaults
# baked into the binary. Only values that differ from the defaults need to
# be set explicitly.
#
# Legend: [REQUIRED] must be set, otherwise the gateway refuses to start.
#         [DEFAULT]  shown after `=`; omit the line to accept it.
#         [PROD]     recommended override for production deployments.
#         [DEV]      convenience override for local development.
#
# ============================================================================

# ----------------------------------------------------------------------------
# HTTP listener
# ----------------------------------------------------------------------------

# Public HTTP listen address. Empty host binds all interfaces.
HTTP_ADDR=:8080

# Full-request (headers + body) read deadline. Protects against slowloris.
HTTP_READ_TIMEOUT=10s

# Full-response write deadline. Protects against slow-client blackholes.
HTTP_WRITE_TIMEOUT=30s

# Keep-alive idle connection timeout.
HTTP_IDLE_TIMEOUT=120s

# Maximum accepted request body size in bytes. Over this, clients get 413.
# Default is 1 MiB — raise if you proxy handlers that accept large payloads.
HTTP_MAX_BODY_BYTES=1048576

# Maximum accepted request header block size, summed across all headers.
HTTP_MAX_HEADER_BYTES=16384

# Toggle h2c (HTTP/2 cleartext). Currently NOT wired — reserved for a future
# release. The flag is accepted so operators can set it in advance without
# config migrations once h2c lands.
HTTP_ENABLE_H2=true

# ----------------------------------------------------------------------------
# NATS transport
# ----------------------------------------------------------------------------

# [REQUIRED] Comma-separated list of NATS server URLs. Supports single URL,
# static cluster list, or a DNS-resolvable hostname (nats.go resolves A/SRV
# records transparently). This is the ONLY field without a default — the
# gateway will refuse to start if it is missing.
#
# Examples:
#   NATS_URLS=nats://nats.internal:4222
#   NATS_URLS=nats://nats-0.internal:4222,nats://nats-1.internal:4222,nats://nats-2.internal:4222
#   NATS_URLS=nats://nats.svc.cluster.local:4222
NATS_URLS=nats://localhost:4222

# Shuffle NATSUrls before dialing to spread initial connections across
# cluster nodes. Disable for deterministic testing.
NATS_RANDOMIZE_URLS=true

# Enable client-side server-discovery protocol so new cluster nodes are
# picked up without a gateway restart.
NATS_DISCOVER_SERVERS=true

# NATS username + password (plain auth). Leave blank for no-auth or when
# using a credentials file.
NATS_USER=
NATS_PASSWORD=

# Filesystem path to an NKey credentials file, used for NGS / decentralised
# JWT auth. Takes precedence over NATS_USER/NATS_PASSWORD when set.
NATS_CREDS_FILE=

# Number of parallel NATS connections maintained by the Requester pool.
# A value of 1 is correct for most workloads. Raise only after benchmarking
# evidence of contention on the single-socket send path.
NATS_CONNECTION_POOL=1

# Delay between reconnection attempts after the NATS connection drops.
NATS_RECONNECT_WAIT=2s

# Cap on reconnection attempts before the client gives up. -1 means retry
# forever, which is the right default for a gateway that must survive
# cluster restarts.
NATS_MAX_RECONNECTS=-1

# In-memory buffer size (bytes) for messages published while the connection
# is temporarily down. Default is 8 MiB.
NATS_RECONNECT_BUFSIZE=8388608

# ----------------------------------------------------------------------------
# Registry (handler KV bucket)
# ----------------------------------------------------------------------------

# Name of the JetStream KV bucket the gateway watches for handler metadata.
# MUST match the bucket name produced by the @zerly/gateway-sdk on the Nest
# side; changing this without coordinating both sides will leave the
# gateway's routing table empty.
KV_BUCKET=handler_registry

# Hard deadline on the initial KV watch hydration. If the first snapshot
# does not arrive within this window the gateway aborts startup rather
# than serving an empty routing table.
KV_WATCH_TIMEOUT=5s

# ----------------------------------------------------------------------------
# Request lifecycle
# ----------------------------------------------------------------------------

# Per-request hard deadline applied to the full handler pipeline (RPC
# round-trip included). Set this below your client-side timeout so the
# gateway always surfaces a deterministic 504 before the client gives up.
REQUEST_TIMEOUT=30s

# How long the graceful-shutdown sequence waits for in-flight requests to
# finish before force-closing. Aligned with Hertz's internal ExitWaitTime
# so the same value bounds both the transport drain and any on-shutdown
# hooks.
SHUTDOWN_TIMEOUT=30s

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------

# Minimum zerolog level. Valid: trace, debug, info, warn, error, fatal,
# panic, disabled.
LOG_LEVEL=info

# Log output encoding. "json" for production and machine ingestion,
# "console" for human-friendly coloured output during local development.
LOG_FORMAT=json

# Toggle per-request access log entries. Turn OFF in very high-throughput
# deployments where log volume becomes a bottleneck, or adjust
# LOG_SAMPLING_RATE instead.
LOG_REQUESTS=true

# Include the full request body in access log entries. Expensive and
# leaks PII — leave OFF unless actively debugging a specific incident in
# a controlled environment.
LOG_REQUEST_BODY=false

# Include the full response body in access log entries. Same caveats as
# LOG_REQUEST_BODY above.
LOG_RESPONSE_BODY=false

# Latency (ms) above which a request is additionally logged at warn level
# regardless of LOG_REQUESTS. Acts as a built-in slow-query log.
LOG_SLOW_REQUEST_MS=1000

# 1-in-N sampling rate for access logs when LOG_REQUESTS is enabled.
# 1 means "log every request". Set higher (10, 100, 1000) to reduce log
# volume on very high-traffic deployments.
LOG_SAMPLING_RATE=1

# ----------------------------------------------------------------------------
# Observability (metrics + tracing)
# ----------------------------------------------------------------------------
#
# NOTE: The metrics endpoint and tracing exporter are declared here for
# forward compatibility and will be wired to a live Prometheus/OTel surface
# in the 0.2.x operator-readiness milestone. Setting these values today is
# safe — the gateway accepts them and will honour them as soon as the
# surface lands.

# Toggle the Prometheus metrics endpoint.
METRICS_ENABLED=true

# Host:port the metrics endpoint listens on, separate from the public HTTP
# listener so operators can firewall it to scrape-only subnets.
METRICS_ADDR=:9090

# HTTP path served by the metrics endpoint.
METRICS_PATH=/metrics

# Toggle OpenTelemetry trace export.
TRACING_ENABLED=false

# Head-based trace sampling ratio in the [0.0, 1.0] range.
TRACING_SAMPLE_RATE=0.01

# ----------------------------------------------------------------------------
# Health probes
# ----------------------------------------------------------------------------
#
# Same forward-compatibility caveat as the Observability block above:
# accepted today, honoured once the operator-readiness milestone wires
# the probe handlers into Hertz.

# Toggle the built-in liveness and readiness endpoints on the public
# listener.
HEALTH_ENABLED=true

# HTTP path for the liveness probe (Kubernetes `livenessProbe.httpGet.path`).
HEALTH_LIVE_PATH=/_gateway/live

# HTTP path for the readiness probe (Kubernetes `readinessProbe.httpGet.path`).
HEALTH_READY_PATH=/_gateway/ready

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------

# Deployment-tier label. The gateway treats "production" specially: in
# production the DefaultErrorBodyFactory redacts stack traces and raw
# error messages from outbound HTTP responses to avoid leaking internal
# diagnostics to clients.
#
# Values: production | staging | development (free-form; only "production"
# triggers redaction today).
ENVIRONMENT=production
